{
  "name": "update and tear down the Chat case",
  "delayMs": 250,
  "steps": [
    {
      "id": "load-chat",
      "operation": "load",
      "path": "app/samples/chat",
      "expect": {
        "activePaths": ["app", "app/samples", "app/samples/chat"]
      }
    },
    {
      "id": "update-chat",
      "operation": "update",
      "path": "app/samples/chat",
      "state": { "chat": { "selectedMessageId": null, "lastAction": null } },
      "expect": {
        "activePaths": ["app", "app/samples", "app/samples/chat"]
      }
    },
    {
      "id": "destroy-chat",
      "operation": "destroy",
      "path": "app/samples/chat",
      "expect": {
        "activePaths": ["app", "app/samples"]
      }
    }
  ]
}
