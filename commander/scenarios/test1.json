{
  "name": "compose app and live, then add widgets after the progressive menu",
  "delayMs": 1000,
  "steps": [
    {
      "id": "reset",
      "operation": "destroy",
      "path": "app",
      "expect": {
        "activePaths": []
      }
    },
    {
      "id": "load-app",
      "operation": "load",
      "path": "app",
      "expect": {
        "activePaths": ["app"]
      }
    },
    {
      "id": "load-live",
      "operation": "load",
      "path": "app/live",
      "expect": {
        "activePaths": ["app", "app/live"]
      }
    },
    {
      "id": "load-widgets",
      "operation": "load",
      "path": "app/live/widgets",
      "expect": {
        "activePaths": ["app", "app/live", "app/live/menu", "app/live/widgets"]
      }
    }
  ]
}
