{
  "name": "compose the default Chat case",
  "delayMs": 250,
  "steps": [
    {
      "id": "reset",
      "operation": "destroy",
      "path": "app",
      "expect": {
        "activePaths": []
      }
    },
    {
      "id": "load-chat",
      "operation": "load",
      "path": "app/samples/chat",
      "expect": {
        "activePaths": ["app", "app/samples", "app/samples/chat"]
      }
    }
  ]
}
